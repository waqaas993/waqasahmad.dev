def cmd_site_project(args: List[str]):
    """Create /work/<slug>/index.html and append entry to /assets/data/work.json."""
    allowed = {
        "--defaults": False,
        "--title": True,
        "--summary": True,
        "--tags": True,
        "--metric": True,
        "--link": True,
    }

    try:
        positionals, flags = _parse_simple_flags(args, allowed)
    except ValueError as e:
        error(str(e))
        return 1

    if not positionals:
        error("site:project requires <slug>")
        return 1

    slug = positionals[0]

    try:
        validate_slug(slug)
    except ValueError as e:
        error(str(e))
        return 1

    project_dir = Path("work") / slug
    project_html = project_dir / "index.html"

    if project_dir.exists():
        error(f"Project directory already exists: {project_dir}")
        return 1

    work_json_path = Path("assets/data/work.json")
    if not work_json_path.exists():
        error("Missing /assets/data/work.json. Run wrun site:work first.")
        return 1

    config_path = Path("warp.config.json")
    if not config_path.exists():
        error("Missing warp.config.json. Run wrun site:init first.")
        return 1

    try:
        config = read_json_file(config_path)
    except Exception as e:
        error(f"Failed to read warp.config.json: {e}")
        return 1

    defaults = bool(flags.get("--defaults"))

    # Collect metadata
    title = flags.get("--title")
    summary = flags.get("--summary")

    if defaults:
        title = title or "(TODO title)"
        summary = summary or "(TODO summary)"
    else:
        if not title:
            title = read_input("title: ")
        if not summary:
            summary = read_input("summary: ")

        if not title or not summary:
            error("title and summary are required")
            return 1

    tags: List[str] = []
    if flags.get("--tags"):
        tags = [t.strip() for t in str(flags.get("--tags")).split(",") if t.strip()]
    elif not defaults:
        raw = read_input("tags (comma-separated, optional): ")
        tags = [t.strip() for t in raw.split(",") if t.strip()] if raw else []

    metrics: List[str] = []
    # NOTE: simple parser supports one --metric via _parse_simple_flags; allow comma-separated.
    if flags.get("--metric"):
        metrics = [m.strip() for m in str(flags.get("--metric")).split(",") if m.strip()]
    elif not defaults:
        info("Metrics (one per line, empty line to finish):")
        while True:
            m = read_input("  metric: ")
            if not m:
                break
            metrics.append(m)

    links: Dict[str, str] = {"page": f"/work/{slug}/"}
    if flags.get("--link"):
        # format: key=value
        raw = str(flags.get("--link"))
        if "=" in raw:
            k, v = raw.split("=", 1)
            k = k.strip()
            v = v.strip()
            if k and v:
                links[k] = v
    elif not defaults:
        info("Links (optional). Enter key=value, empty line to finish:")
        while True:
            kv = read_input("  link: ")
            if not kv:
                break
            if "=" not in kv:
                warn("Expected key=value")
                continue
            k, v = kv.split("=", 1)
            k = k.strip()
            v = v.strip()
            if k and v:
                links[k] = v

    entry: Dict[str, Any] = {
        "slug": slug,
        "title": title,
        "summary": summary,
        "links": links,
    }
    if tags:
        entry["tags"] = tags
    if metrics:
        entry["metrics"] = metrics

    # Transactional behavior: validate + build outputs before writing.
    try:
        data = read_json_file(work_json_path)
        if not isinstance(data, list):
            error("work.json must be a JSON array")
            return 1

        for existing in data:
            if isinstance(existing, dict) and existing.get("slug") == slug:
                error(f"Duplicate slug in work.json: {slug}")
                return 1

        new_data = data + [entry]

        created: List[Path] = []
        try:
            project_dir.mkdir(parents=True, exist_ok=False)
            created.append(project_dir)

            write_text_atomic(project_html, _render_project_html(config, entry))
            created.append(project_html)

            write_json_atomic(work_json_path, new_data)

            success(f"Created /work/{slug}/ and updated work.json")
            return 0
        except Exception as e:
            _rollback_paths(created)
            error(str(e))
            return 1

    except Exception as e:
        error(str(e))
        return 1


