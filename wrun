def validate_slug(slug: str) -> None:
    """Validate strict kebab-case slug rules."""
    if not (2 <= len(slug) <= 60):
        raise ValueError(
            f"Invalid slug: {slug!r}\nSlugs must be kebab-case (a–z, 0–9, -), 2–60 chars.\nExample: pack-match-3d"
        )
    if not _SLUG_RE.fullmatch(slug):
        raise ValueError(
            f"Invalid slug: {slug!r}\nSlugs must be kebab-case (a–z, 0–9, -), 2–60 chars.\nExample: pack-match-3d"
        )


def validate_base_url(base_url: str) -> None:
    """Validate strict base_url rules (https:// and no trailing slash)."""
    if not base_url.startswith("https://"):
        raise ValueError("base_url must start with https://")
    if base_url.endswith("/"):
        raise ValueError("base_url must NOT end with /")


def _json_dumps_stable(data: Any) -> str:
    return json.dumps(data, indent=2, sort_keys=True, ensure_ascii=False) + "\n"


def read_json_file(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def write_text_atomic(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="w",
        encoding="utf-8",
        dir=str(path.parent),
        delete=False,
        prefix=f".{path.name}.",
        suffix=".tmp",
    ) as f:
        f.write(content)
        tmp_name = f.name
    os.replace(tmp_name, path)


def write_bytes_atomic(path: Path, content: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        mode="wb",
        dir=str(path.parent),
        delete=False,
        prefix=f".{path.name}.",
        suffix=".tmp",
    ) as f:
        f.write(content)
        tmp_name = f.name
    os.replace(tmp_name, path)


def write_json_atomic(path: Path, data: Any) -> None:
    write_text_atomic(path, _json_dumps_stable(data))


def _rollback_paths(paths: List[Path]) -> None:
    for p in reversed(paths):
        try:
            if p.is_file() or p.is_symlink():
                p.unlink()
            elif p.is_dir():
                shutil.rmtree(p)
        except FileNotFoundError:
            pass


def _parse_simple_flags(args: List[str], allowed: Dict[str, bool]) -> Tuple[List[str], Dict[str, Any]]:
    """Parse basic flags.

    allowed maps flag -> has_value.
    Supports --flag and --flag=value.
    """
    positionals: List[str] = []
    out: Dict[str, Any] = {}

    i = 0
    while i < len(args):
        a = args[i]
        if a.startswith("--"):
            if "=" in a:
                name, value = a.split("=", 1)
                if name not in allowed or not allowed[name]:
                    raise ValueError(f"Unknown or valueless flag: {name}")
                out[name] = value
                i += 1
                continue

            if a not in allowed:
                raise ValueError(f"Unknown flag: {a}")

            if allowed[a]:
                if i + 1 >= len(args):
                    raise ValueError(f"Missing value for {a}")
                out[a] = args[i + 1]
                i += 2
            else:
                out[a] = True
                i += 1
        else:
            positionals.append(a)
            i += 1

    return positionals, out

