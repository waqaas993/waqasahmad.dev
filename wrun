def _render_theme_init_script() -> str:
    # Keep this tiny and deterministic.
    return """<script>
(function(){
  var key='theme';
  var stored=null;
  try{stored=localStorage.getItem(key);}catch(e){}
  var prefers=false;
  try{prefers=window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;}catch(e){}
  var isDark = stored ? stored==='dark' : prefers;
  if(isDark){document.documentElement.classList.add('dark');}
})();
</script>"""


def _render_theme_toggle_script(button_id: str = "theme-toggle") -> str:
    return f"""<script>
(function(){{
  var key='theme';
  var btn=document.getElementById('{button_id}');
  if(!btn) return;
  function set(mode){{
    try{{localStorage.setItem(key, mode);}}catch(e){{}}
    if(mode==='dark') document.documentElement.classList.add('dark');
    else document.documentElement.classList.remove('dark');
  }}
  btn.addEventListener('click', function(){{
    var isDark=document.documentElement.classList.contains('dark');
    set(isDark ? 'light' : 'dark');
  }});
}})();
</script>"""


