def cmd_site_init(args: List[str]):
    """Scaffold a deterministic GitHub Pages static site in the current directory."""
    allowed = {
        "--defaults": False,
    }

    try:
        positionals, flags = _parse_simple_flags(args, allowed)
    except ValueError as e:
        error(str(e))
        return 1

    if positionals:
        error("site:init does not accept positional args")
        return 1

    collisions = [Path("index.html"), Path("work"), Path("assets"), Path("warp.config.json")]
    for p in collisions:
        if p.exists():
            error(f"site:init refused: {p} already exists")
            return 1

    defaults = bool(flags.get("--defaults"))

    if defaults:
        config: Dict[str, Any] = {
            "site_title": "(Your Site Title)",
            "site_description": "(A short description)",
            "base_url": "https://example.com",
            "author_name": "(Your Name)",
            "cname": "example.com",
            "contact_email": "you@example.com",
            "socials": {
                "github": "https://github.com/your-handle",
                "linkedin": "https://www.linkedin.com/in/your-handle/",
            },
            "nav": [
                {"label": "Home", "href": "/"},
                {"label": "Work", "href": "/work/"},
                {"label": "Contact", "href": "/#contact"},
            ],
            "seo_defaults": {
                "og_title": "(Your Site Title)",
                "og_description": "(A short description)",
                "og_image": "/assets/images/og.png",
                "favicon": "/assets/images/favicon.png",
            },
        }
    else:
        print()
        info("=== Site Init (GitHub Pages, repo-root HTML) ===")
        print()

        site_title = read_input("site_title: ")
        site_description = read_input("site_description: ")
        base_url = read_input("base_url (https://..., no trailing slash): ")
        author_name = read_input("author_name: ")
        cname = read_input("cname (domain, e.g. waqasahmad.dev): ")
        contact_email = read_input("contact_email: ")
        github_url = read_input("GitHub URL: ")
        linkedin_url = read_input("LinkedIn URL: ")

        try:
            validate_base_url(base_url)
        except ValueError as e:
            error(str(e))
            return 1

        config = {
            "site_title": site_title,
            "site_description": site_description,
            "base_url": base_url,
            "author_name": author_name,
            "cname": cname,
            "contact_email": contact_email,
            "socials": {
                "github": github_url,
                "linkedin": linkedin_url,
            },
            "nav": [
                {"label": "Home", "href": "/"},
                {"label": "Work", "href": "/work/"},
                {"label": "Contact", "href": "/#contact"},
            ],
            "seo_defaults": {
                "og_title": site_title,
                "og_description": site_description,
                "og_image": "/assets/images/og.png",
                "favicon": "/assets/images/favicon.png",
            },
        }

    created: List[Path] = []
    try:
        # Validate base_url even for defaults.
        validate_base_url(str(config.get("base_url", "")))

        # Write config first.
        write_json_atomic(Path("warp.config.json"), config)
        created.append(Path("warp.config.json"))

        # Directories
        Path("work").mkdir(parents=True, exist_ok=False)
        created.append(Path("work"))
        Path("assets/data").mkdir(parents=True, exist_ok=False)
        created.append(Path("assets"))
        Path("assets/js").mkdir(parents=True, exist_ok=True)
        Path("assets/css").mkdir(parents=True, exist_ok=True)
        Path("assets/images").mkdir(parents=True, exist_ok=True)

        images_dir = Path("images")
        downloads_dir = Path("downloads")
        images_created = False
        downloads_created = False
        if not images_dir.exists():
            images_dir.mkdir(parents=True, exist_ok=False)
            images_created = True
        if not downloads_dir.exists():
            downloads_dir.mkdir(parents=True, exist_ok=False)
            downloads_created = True
        if images_created:
            created.append(images_dir)
        if downloads_created:
            created.append(downloads_dir)

        # Files
        write_text_atomic(Path("index.html"), _render_index_html(config))
        created.append(Path("index.html"))

        write_text_atomic(Path("work/index.html"), _render_work_index_html(config))
        created.append(Path("work/index.html"))

        if not Path("assets/data/work.json").exists():
            write_json_atomic(Path("assets/data/work.json"), [])
            created.append(Path("assets/data/work.json"))

        write_text_atomic(Path("assets/js/work.js"), _default_work_js())
        created.append(Path("assets/js/work.js"))

        write_text_atomic(Path("assets/css/site.css"), "/* Optional site overrides (v1) */\n")
        created.append(Path("assets/css/site.css"))

        write_bytes_atomic(Path("assets/images/og.png"), _PNG_1X1)
        created.append(Path("assets/images/og.png"))

        write_bytes_atomic(Path("assets/images/favicon.png"), _PNG_1X1)
        created.append(Path("assets/images/favicon.png"))

        # Human-managed placeholder assets
        # Create placeholders ONLY when we created the directory as part of site:init.
        if images_created:
            profile_path = Path("images/profile.webp")
            if not profile_path.exists():
                write_bytes_atomic(profile_path, _WEBP_1X1)
                created.append(profile_path)

        if downloads_created:
            cv_path = Path("downloads/waqas-ahmad-cv.pdf")
            if not cv_path.exists():
                write_bytes_atomic(cv_path, _PDF_PLACEHOLDER)
                created.append(cv_path)

            portfolio_path = Path("downloads/waqas-ahmad-portfolio.pdf")
            if not portfolio_path.exists():
                write_bytes_atomic(portfolio_path, _PDF_PLACEHOLDER)
                created.append(portfolio_path)

        write_text_atomic(Path("CNAME"), str(config.get("cname", "")) + "\n")
        created.append(Path("CNAME"))

        write_text_atomic(Path(".nojekyll"), "")
        created.append(Path(".nojekyll"))

        write_text_atomic(Path("robots.txt"), "User-agent: *\nAllow: /\n")
        created.append(Path("robots.txt"))

        base_url = str(config.get("base_url", ""))
        sitemap = f"""<?xml version=\"1.0\" encoding=\"UTF-8\"?>
<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">
  <url><loc>{base_url}/</loc></url>
  <url><loc>{base_url}/work/</loc></url>
</urlset>
"""
        write_text_atomic(Path("sitemap.xml"), sitemap)
        created.append(Path("sitemap.xml"))

        write_text_atomic(Path(".gitignore"), _default_gitignore())
        created.append(Path(".gitignore"))

        write_text_atomic(Path("README.md"), _default_site_readme())
        created.append(Path("README.md"))

        success("Site scaffold created.")
        return 0
    except Exception as e:
        _rollback_paths(created)
        error(str(e))
        return 1


def cmd_site_work(args: List[str]):
    """Ensure /work/index.html and /assets/data/work.json exist (create-missing only)."""
    allowed = {
        "--force": False,
    }

    try:
        positionals, flags = _parse_simple_flags(args, allowed)
    except ValueError as e:
        error(str(e))
        return 1

    if positionals:
        error("site:work does not accept positional args")
        return 1

    force = bool(flags.get("--force"))

    config_path = Path("warp.config.json")
    config: Dict[str, Any] = {}
    if config_path.exists():
        try:
            config = read_json_file(config_path)
        except Exception:
            config = {}

    created: List[Path] = []
    try:
        Path("assets/data").mkdir(parents=True, exist_ok=True)
        Path("assets/js").mkdir(parents=True, exist_ok=True)
        Path("assets/css").mkdir(parents=True, exist_ok=True)

        work_json = Path("assets/data/work.json")
        if not work_json.exists():
            write_json_atomic(work_json, [])
            created.append(work_json)

        work_html = Path("work/index.html")
        if not work_html.exists():
            Path("work").mkdir(parents=True, exist_ok=True)
            write_text_atomic(work_html, _render_work_index_html(config))
            created.append(work_html)

        # Assets are generator-managed; allow refresh with --force.
        work_js = Path("assets/js/work.js")
        work_js_existed = work_js.exists()
        if force or not work_js_existed:
            write_text_atomic(work_js, _default_work_js())
            if not work_js_existed:
                created.append(work_js)

        site_css = Path("assets/css/site.css")
        site_css_existed = site_css.exists()
        if force or not site_css_existed:
            write_text_atomic(site_css, "/* Optional site overrides (v1) */\n")
            if not site_css_existed:
                created.append(site_css)

        success("Work page ensured.")
        return 0
    except Exception as e:
        _rollback_paths(created)
        error(str(e))
        return 1


def _default_work_js() -> str:
    # Keep render logic compact; avoid console errors.
    return """(function(){
  function showHint(msg){
    var el=document.getElementById('work-hint');
    if(!el) return;
    el.textContent=msg;
